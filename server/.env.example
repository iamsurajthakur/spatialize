# Copy this file to .env and replace the placeholders with your own values.
# Local mode uses SQLite and local images. Render sets this to false.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=your_available_image_capable_model_id
# Empty disables model switching; otherwise use comma-separated model IDs.
GEMINI_FALLBACK_MODELS=
GEMINI_TIMEOUT_MS=60000

# Production: configure these in Render, not in Git. See DEPLOYMENT.md.
# DJANGO_SECRET_KEY=generate_a_long_random_secret
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# MEDIA_STORAGE=s3
# AWS_S3_ENDPOINT_URL=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
# AWS_S3_REGION_NAME=your_supabase_region
# AWS_STORAGE_BUCKET_NAME=scene-images
# AWS_ACCESS_KEY_ID=your_supabase_s3_access_key
# AWS_SECRET_ACCESS_KEY=your_supabase_s3_secret_key
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-backend.onrender.com
# DJANGO_TRUST_PROXY=true
