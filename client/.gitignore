# Dependencies and package-manager caches (keep bun.lock versioned)
/node_modules
/.pnp
.pnp.*
.bun/
.npm/
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Test and coverage output
/coverage
/.nyc_output/
/playwright-report/
/test-results/

# Next.js and production build output
/.next/
/out/
/build
/dist/
/.turbo/
/.cache/

# Local certificates and private keys
*.pem
*.key

# Package-manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local deployment metadata
.vercel

# Generated TypeScript files
*.tsbuildinfo
next-env.d.ts
